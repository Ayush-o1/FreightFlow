# FreightFlow Client — Environment Variables

# Backend API base URL — no trailing slash
VITE_API_BASE_URL=http://localhost:5001
# For same-origin Docker/Kubernetes Nginx proxying, leave blank:
# VITE_API_BASE_URL=
# Replace with your backend URL in production
# Example: VITE_API_BASE_URL=https://your-backend.onrender.com
