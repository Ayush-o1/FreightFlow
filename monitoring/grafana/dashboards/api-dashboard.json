{
  "uid": "freightflow-api",
  "title": "FreightFlow API",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "tags": ["freightflow", "api"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(freightflow_http_requests_total[5m])) by (method)", "legendFormat": "{{method}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(freightflow_http_request_errors_total[5m])) by (status_code)", "legendFormat": "{{status_code}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 Latency",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(freightflow_http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "{{route}}" }
      ],
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 }
    }
  ]
}
