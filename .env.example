# ─────────────────────────────────────────────────────────────────────────────
#  FreightFlow Backend — Environment Variables Template
#  Copy this file to .env and fill in the values.
#  NEVER commit your actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/freightflow
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/FreightFlow
MONGODB_URI=
# MONGO_URI is also accepted for compatibility with some hosting providers.
MONGO_URI=

# ── JSON Web Token ────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Reserved for refresh-token signing if multi-session JWT refresh tokens are added later.
# Phase 5 validates it at startup so production secrets are complete.
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
ACCESS_TOKEN_COOKIE_MAX_AGE_MS=900000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin — used by CORS and Socket.io
CLIENT_URL=http://localhost:5173

# ── Cookies / Deployment ─────────────────────────────────────────────────────
# For same-site local development keep strict. For separate production domains,
# use COOKIE_SAME_SITE=none and COOKIE_SECURE=true over HTTPS.
COOKIE_SAME_SITE=strict
COOKIE_SECURE=
COOKIE_DOMAIN=
TRUST_PROXY=

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_ENABLED=true
OTEL_ENABLED=true
OTEL_SERVICE_NAME=freightflow-api
# Example collector endpoint. Leave blank to keep tracing initialized without export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Redis / Distributed Infrastructure ───────────────────────────────────────
# Required for distributed rate limiting, Socket.IO scaling, BullMQ queues,
# idempotency records, analytics cache, and recovery jobs.
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=2
CACHE_TTL=300
QUEUE_WORKERS_ENABLED=true

# ── Admin Seed Account ────────────────────────────────────────────────────────
# Used by: node src/scripts/seedAdmin.js
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin
